as="geometry"/></mxCell><mxCell id="c21" value="cilium-agent + BPF&lt;br&gt;命中 policy：经 VXLAN&lt;br&gt;送往网关 A" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="50" y="860" width="260" height="80" as="geometry"/></mxCell><mxCell id="c22" value="上游交换机 / 路由器&lt;br&gt;ARP 表：VIP → 节点 A 的 MAC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="740" width="420" height="60" as="geometry"/></mxCell><mxCell id="c23" value="外部服务（看到的源 IP = VIP）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="880" width="420" height="50" as="geometry"/></mxCell><mxCell id="c24" value="图例&lt;br&gt;红色粗线：数据面（出口流量）&lt;br&gt;蓝色实线：controller 写入状态和 label&lt;br&gt;绿色实线：agent 的动作&lt;br&gt;橙色虚线：controller 的 TCP 探测&lt;br&gt;紫色虚线：admission webhook&lt;br&gt;&lt;br&gt;VIP 配好后，转发只依赖网卡 VIP 和 BPF map；&lt;br&gt;agent、controller 重启都不影响出口流量" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="920" y="720" width="460" height="250" as="geometry"/></mxCell><mxCell id="c25" value="出口流量" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#d62728;strokeWidth=3;fontColor=#d62728;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="VXLAN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;rounded=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#d62728;align=left;" vertex="1" parent="1"><mxGeometry x="376" y="760" width="60" height="24" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fo