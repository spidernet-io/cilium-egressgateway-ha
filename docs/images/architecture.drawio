<mxfile><diagram name="architecture"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="用户&lt;br&gt;创建 policy&lt;br&gt;只写 selector、CIDR&lt;br&gt;（可选 egressIP）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Kubernetes API Server" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="1000" height="200" as="geometry"/></mxCell><mxCell id="c5" value="CiliumEgressGatewayPolicy&lt;br&gt;label managed=true&lt;br&gt;egressIP: VIP&lt;br&gt;nodeSelector:&lt;br&gt;  egress-gw-active=true" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="55" width="180" height="150" as="geometry"/></mxCell><mxCell id="c6" value="ConfigMap&lt;br&gt;egress-gw-ha-config&lt;br&gt;candidateNodeSelector&lt;br&gt;primary: A（可选）&lt;br&gt;interface / vipPool&lt;br&gt;defaultEgressIP&lt;br&gt;probe / selfFenceTimeout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="595" y="55" width="180" height="150" as="geometry"/></mxCell><mxCell id="c7" value="ConfigMap&lt;br&gt;egress-gw-ha-state&lt;br&gt;&lt;br&gt;activeNode: A&lt;br&gt;observedPrimary: A&lt;br&gt;observedSwitchover" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeColor=#1f5fbf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="790" y="55" width="180" height="150" as="geometry"/></mxCell><mxCell id="c8" value="Node / CiliumNode&lt;br&gt;A: egress-gw-a