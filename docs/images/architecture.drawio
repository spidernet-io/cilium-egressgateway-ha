<mxfile><diagram name="architecture"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="用户&lt;br&gt;创建 policy&lt;br&gt;只写 selector、CIDR&lt;br&gt;（可选 egressIP）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Kubernetes API Server" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="1000" height="200" as="geometry"/></mxCell><mxCell id="c5" value="CiliumEgressGatewayPolicy&lt;br&gt;nodeSelector: 主网关 label&lt;br&gt;（用户填写，即表示纳管）&lt;br&gt;egressIP: VIP&lt;br&gt;（未填写时由 webhook 补全）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="55" width="180" height="150" as="geometry"/></mxCell><mxCell id="c6" value="EgressGatewayHA default（controller 按 Helm 默认值创建）&lt;br&gt;spec: egressNodeSelector / interface&lt;br&gt;      egressIPs / defaultEgressIP&lt;br&gt;      activeNode: A（默认空，controller 写入）&lt;br&gt;status: activeNode: {name: A, egressIPs, ready}（主网关 agent）&lt;br&gt;        egressNodes[].reachable / lastTransitionTime（controller）&lt;br&gt;        conditions: ActiveNode* / Switching / GatewayReady / Ready" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeColor=#1f5fbf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="595" y="55" width="375" height="150" as="geometry"/></mxCell><mxCell id="c7" value="Node / CiliumNode label&lt;br&gt;A: egressgateway-ha.spidernet.io/active-node=true&lt;br&gt;B: 无&lt;br&gt;（controller 只打在出口节点上）&lt;br&gt;&lt;br&gt;Node Ready condition&lt;br&gt;（controller 探测条件之一）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="985" y="55" width="375" height="150" as="geometry"/></mxCell><mxCell id="c8" value="master 节点" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="320" height="300" as="geometry"/></mxCell><mxCell id="c9" value="controller 工作实例&lt;br&gt;· TCP 探测 + 检查 Node Ready&lt;br&gt;· 选择新主网关&lt;br&gt;· 两阶段切换&lt;br&gt;· webhook" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="280" height="120" as="geometry"/></mxCell><mxCell id="c10" value="controller 备用副本&lt;br&gt;· webhook&lt;br&gt;· 工作实例故障时接管" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="280" height="90" as="geometry"/></mxCell><mxCell id="c11" value="出口节点 A（匹配 egressNodeSelector，主网关）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="460" height="300" as="geometry"/></mxCell><mxCell id="c12" value="cilium-agent + BPF&lt;br&gt;watch CiliumNode label&lt;br&gt;选 A 为网关&lt;br&gt;SNAT：源 IP → VIP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="200" height="110" as="geometry"/></mxCell><mxCell id="c13" value="egw-ha agent&lt;br&gt;（hostNetwork）&lt;br&gt;本节点是 activeNode：&lt;br&gt;确保 VIP 存在" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;fontStyle=1;" vert