<mxfile><diagram name="agent-workflow"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="agent 启动（5.1）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;ellipse;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="20" width="160" height="50" as="geometry"/></mxCell><mxCell id="c4" value="读取配置 / 状态 ConfigMap&lt;br&gt;和所有被管理的 policy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="230" y="100" width="340" height="60" as="geometry"/></mxCell><mxCell id="c5" value="能访问&lt;br&gt;API Server？" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="200" width="240" height="100" as="geometry"/></mxCell><mxCell id="c6" value="保持网卡现状不变&lt;br&gt;已有 VIP 最多 selfFenceTimeout 后到期" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="215" width="300" height="70" as="geometry"/></mxCell><mxCell id="c7" value="本节点是&lt;br&gt;activeNode？" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="350" width="240" height="100" as="geometry"/></mxCell><mxCell id="c8" value="删除所有被管理的 VIP&lt;br&gt;上报 vipReady: false" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="365" width="300" height="70" as="geometry"/></mxCell><mxCell id="c9" value="对每个还不在网卡上的 VIP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="230" y="500" width="340" height="50" as="geometry"/></mxCell><mxCell id="c10" value="重复地址检测（arping -D）&lt;br&gt;有设备回应？" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="270" y="590" width="260" height="110" as="geometry"/></mxCell><mxCell id="c11" value="不添加，上报 conflict&lt;br&gt;下一轮重试" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="640" y="610" width="300" height="70" as="geometry"/></mxCell><mxCell id="c12" value="添加 VIP/32（带有效期）+ GARP&lt;br&gt;patch 本节点 CiliumNode annotation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="230" y="750" width="340" height="70" as="geometry"/></mxCell><mxCell id="c13" value="刷新所有 VIP 的有效期&lt;br&gt;lft = 最后一次成功访问 API Server 的&lt;br&gt;         请求开始时间 + selfFenceTimeout − now&lt;br&gt;lft ≤ 0 时不再刷新，由内核删除 VIP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="190" y="870" width="420" height="100" as="geometry"/></mxCell><mxCell id="c14" value="所有 VIP 都已添加时上报 vipReady: true&lt;br&gt;garpInterval &amp;gt; 0 时周期发送 GARP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="230" y="1020" width="340" height="60" as="geometry"/></mxCell><mxCell id="c15" value="等待 watch 事件，或每 10s reconcile" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="1130" width="340" height="50" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="其他 VIP 继续" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="920"/></Array></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c6" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="250"/><mxPoint x="980" y="1155"/></Array></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c8" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="400"/><mxPoint x="980" y="1155"/></Array></mxGeometry></mxCell><mxCell id="c31" value="下一轮" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c15" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="1155"/><mxPoint x="150" y="250"/></Array></mxGeometry></mxCell><mxCell id="c32" value="收到 SIGTERM（升级 / 驱逐，5.3）&lt;br&gt;· 不删除 VIP，不修改 label，直接退出&lt;br&gt;· 新 Pod 启动后沿用已有 VIP，出口流量不受影响&lt;br&gt;· 例外：本节点已不是候选节点，且不是 activeNode&lt;br&gt;  → 删除 VIP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="1230" width="420" height="120" as="geometry"/></mxCell><mxCell id="c33" value="进程异常，或长时间无法访问 API Server&lt;br&gt;（SIGKILL / OOM / 冻结 / 网络分区）&lt;br&gt;· 有效期不再刷新&lt;br&gt;· 最多 selfFenceTimeout 后内核删除 VIP&lt;br&gt;  → 自我隔离，不会与新主网关双主" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="520" y="1230" width="460" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>