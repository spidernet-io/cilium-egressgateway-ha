<mxfile><diagram name="workflow"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Pod 启动" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;ellipse;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="140" height="50" as="geometry"/></mxCell><mxCell id="c4" value="5.1 启动清理&lt;br&gt;· 按 label eth0:egw 删除本机所有 VIP&lt;br&gt;· 删除本节点 Node / CiliumNode 的 active label" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="230" y="100" width="340" height="80" as="geometry"/></mxCell><mxCell id="c5" value="本机 cilium-agent&lt;br&gt;healthz 正常？" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="220" width="240" height="100" as="geometry"/></mxCell><mxCell id="c6" value="Lease 无人持有&lt;br&gt;或已过期？" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="370" width="240" height="100" as="geometry"/></mxCell><mxCell id="c7" value="5.2 成为 leader（顺序固定）&lt;br&gt;1. 读取 policy，得到 VIP 列表&lt;br&gt;2. 添加 VIP/32（带 valid_lft）并发送 GARP&lt;br&gt;3. 本节点 Node + CiliumNode 打 active label&lt;br&gt;4. 删除其他节点 Node + CiliumNode 的 active label" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="210" y="520" width="380" height="120" as="geometry"/></mxCell><mxCell id="c8" value="5.3 作为 leader 运行（每 RetryPeriod）&lt;br&gt;· 续约 Lease&lt;br&gt;· 刷新 VIP 有效期：&lt;br&gt;   lft = min(VIPLifetime, 续约开始时间 + RenewDeadline − now)&lt;br&gt;· policy 新增 VIP：添加 + GARP + patch CiliumNode annotation&lt;br&gt;· reconcile：VIP 在网卡上，只有本节点有 active label" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="190" y="690" width="420" height="140" as="geometry"/></mxCell><mxCell id="c9" value="续约成功？" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="880" width="200" height="90" as="geometry"/></mxCell><mxCell id="c10" value="距上次成功续约&lt;br&gt;超过 RenewDeadline？" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="1010" width="240" height="100" as="geometry"/></mxCell><mxCell id="c11" value="5.4 降级&lt;br&gt;1. 立即删除本机 VIP（不依赖 API Server）&lt;br&gt;2. 尽量删除本节点 active label&lt;br&gt;3. 退出进程" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="230" y="1160" width="340" height="90" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="否：等待 RetryPeriod" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.65;entryY=0;" edge="1" parent="1" source="c5" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="270"/><mxPoint x="600" y="200"/><mxPoint x="436" y="200"/></Array></mxGeometry></mxCell><mxCell id="c16" value="否：Lease 被其他节点持有&lt;br&gt;重试间隔 RetryPeriod × (1～2.2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="420"/><mxPoint x="190" y="270"/></Array></mxGeometry></mxCell><mxCell id="c17" value="是：获取 Lease" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="925"/><mxPoint x="170" y="732"/></Array></mxGeometry></mxCell><mxCell id="c21" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="否：重试" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="c10" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="1060"/><mxPoint x="150" y="788"/></Array></mxGeometry></mxCell><mxCell id="c23" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="kubelet 重启容器" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="1205"/><mxPoint x="100" y="45"/></Array></mxGeometry></mxCell><mxCell id="c25" value="收到 SIGTERM（滚动升级 / 驱逐 / 节点维护）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;ellipse;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="600" width="300" height="50" as="geometry"/></mxCell><mxCell id="c26" value="5.5 优雅退出&lt;br&gt;1. 先删除本机 VIP&lt;br&gt;2. 删除本节点 active label&lt;br&gt;3. 释放 Lease，备节点立即接管&lt;br&gt;注意：必须先删 VIP，再 cancel ctx" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="680" width="300" height="120" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="任意时刻" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="进程异常&lt;br&gt;（SIGKILL / OOM / 冻结 / CrashLoop）&lt;br&gt;清理逻辑不会执行&lt;br&gt;→ 内核在 valid_lft 到期后自动删除 VIP&lt;br&gt;→ 新 leader 接管前，旧节点已失去 VIP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="850" width="300" height="120" as="geometry"/></mxCell><mxCell id="c30" value="任意时刻" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="参数约束&lt;br&gt;VIPLifetime ≤ RenewDeadline &amp;lt; LeaseDuration&lt;br&gt;默认：10s ≤ 10s &amp;lt; 15s，RetryPeriod 2s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="1020" width="300" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>