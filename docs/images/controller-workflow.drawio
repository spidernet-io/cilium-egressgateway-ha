<mxfile><diagram name="controller-workflow"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="controller 工作实例&lt;br&gt;每次探测结束后等 interval（5s）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;ellipse;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="290" y="20" width="220" height="50" as="geometry"/></mxCell><mxCell id="c4" value="spec.activeNode 为空？&lt;br&gt;（初次部署）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="220" height="90" as="geometry"/></mxCell><mxCell id="c5" value="TCP 连接 activeNode 的 kubelet 端口（超时 2s）&lt;br&gt;并检查 Node Ready condition" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="250" y="240" width="300" height="50" as="geometry"/></mxCell><mxCell id="c6" value="连续 failureThreshold 次连接超时？&lt;br&gt;（成功或被拒绝都算存活）&lt;br&gt;或 Node Ready 为 False / Unknown？" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="230" y="330" width="340" height="130" as="geometry"/></mxCell><mxCell id="c7" value="不触发切换，只记录 Event：&lt;br&gt;NetworkUnavailable、agent Pod 未就绪、&lt;br&gt;cilium-agent 未就绪" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;dashed=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="350" width="300" height="90" as="geometry"/></mxCell><mxCell id="c8" value="至少一个备选节点&lt;br&gt;TCP 探测成功？&lt;br&gt;（只用于 TCP 触发）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="270" y="510" width="260" height="100" as="geometry"/></mxCell><mxCell id="c9" value="判定为 controller 自身网络问题&lt;br&gt;不切换，只告警" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="640" y="525" width="300" height="70" as="geometry"/></mxCell><mxCell id="c10" value="选择新主网关（可用候选节点：匹配 selector、TCP 探测成功、&lt;br&gt;Node Ready、cilium-agent Ready、agent Pod Ready）&lt;br&gt;· 初次部署：字典序第一个&lt;br&gt;· 故障切换：字典序排在当前 activeNode 之后的下一个（循环）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="160" y="660" width="480" height="110" as="geometry"/></mxCell><mxCell id="c11" value="有可选节点？" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="830" width="200" height="90" as="geometry"/></mxCell><mxCell id="c12" value="只告警，保持现状" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="640" y="840" width="300" height="70" as="geometry"/></mxCell><mxCell id="c13" value="第一阶段：写入 spec.activeNode = 新节点" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;strokeColor=#1f5fbf;fontColor=#1f5fbf;fillColor=#dae8fc;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="970" width="400" height="70" as="geometry"/></mxCell><mxCell id="c14" value="agent watch 到变化后：&lt;br&gt;· 新节点：DAD → 添加 VIP → GARP&lt;br&gt;  → 写 status.vip（ready: true）&lt;br&gt;· 旧节点（能访问 API Server 时）：删除 VIP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="660" y="918" width="320" height="92" as="geometry"/></mxCell><mxCell id="c15" value="status.vip.node&lt;br&gt;= spec.activeNode，&lt;br&gt;且 status.vip.ready？" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="1100" width="320" height="130" as="geometry"/></mxCell><mxCell id="c16" value="计划内切换（5.6）&lt;br&gt;运维修改 spec.activeNode&lt;br&gt;目标不可用：恢复为 status.activeNode" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="1125" width="320" height="80" as="geometry"/></mxCell><mxCell id="c17" value="第二阶段：修改 label&lt;br&gt;1. 新节点 Node + CiliumNode 打 active label&lt;br&gt;2. 删除其他所有节点 Node + CiliumNode 的 active label&lt;br&gt;3. 更新 status.activeNode" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#dae8fc;strokeColor=#1f5fbf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="200" y="1290" width="400" height="90" as="geometry"/></mxCell><mxCell id="c18" value="所有 cilium-agent 把网关切到新节点&lt;br&gt;新建连接恢复" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="230" y="1430" width="340" height="60" as="geometry"/></mxCell><mxCell id="c19" value="工作实例中途重启：&lt;br&gt;比较 spec 与 status.activeNode，结合&lt;br&gt;status.vip 恢复进度，继续第二阶段" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;dashed=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="1290" width="320" height="90" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="155"/><mxPoint x="1000" y="720"/></Array></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="否：正常，下一周期" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="395"/><mxPoint x="120" y="45"/></Array></mxGeometry></mxCell><mxCell id="c25" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="否：继续等待（label 不动，流量仍走旧节点）&lt;br&gt;DAD 冲突时 VIPConflict=True" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c15" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="1165"/><mxPoint x="160" y="1075"/><mxPoint x="400" y="1075"/></Array></mxGeometry></mxCell><mxCell id="c34" value="目标可用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c16" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>